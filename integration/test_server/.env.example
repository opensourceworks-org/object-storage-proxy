# ── Garage backend (written by bootstrap.py) ──────────────────────────────────
GARAGE_HOST=localhost
GARAGE_PORT=3900
GARAGE_REGION=garage
GARAGE_BUCKET=test-bucket
GARAGE_ACCESS_KEY_ID=<written by bootstrap>
GARAGE_SECRET_ACCESS_KEY=<written by bootstrap>

# ── OSP proxy (what clients use to talk to the proxy) ─────────────────────────
OSP_PROXY_HOST=localhost
OSP_PROXY_PORT=6190
OSP_METRICS_PORT=9091
OSP_CLIENT_ACCESS_KEY=osp-client
OSP_CLIENT_SECRET_KEY=osp-client-secret
